---
import BaseLayout from '../layouts/BaseLayout.astro';
import Section from '../components/ui/Section.astro';
import SectionHeading from '../components/ui/SectionHeading.astro';
import Button from '../components/ui/Button.astro';
---
<BaseLayout title="페이지를 찾을 수 없습니다" description="요청하신 페이지를 찾을 수 없습니다." noindex>
  <Section tone="ink"><div class="error-page"><p>404</p><SectionHeading as="h1" title="페이지를 찾을 수 없습니다." lead="주소가 바뀌었거나 삭제된 페이지입니다." onDark align="center" /><div class="flex gap-3"><Button href="/">홈으로</Button><Button href="/work" variant="secondary" onDark>구축 사례</Button></div></div></Section>
</BaseLayout>

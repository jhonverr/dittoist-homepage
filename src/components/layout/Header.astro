---
import Container from '../ui/Container.astro';
import Button from '../ui/Button.astro';
import { NAV_LINKS } from '../../lib/site';
---

<header class="site-header">
  <Container class="flex h-18 items-center justify-between gap-6">
    <a href="/" class="logo" aria-label="디토이스트 홈"><span>D:</span> Dittoist</a>
    <nav aria-label="주요 메뉴" class="desktop-nav">
      {NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
      <Button href="/contact" size="md">상담하기</Button>
    </nav>
    <button class="menu-button" type="button" aria-expanded="false" aria-controls="mobile-menu">
      <span class="sr-only">메뉴 열기</span><span></span><span></span><span></span>
    </button>
  </Container>
  <nav id="mobile-menu" class="mobile-menu" aria-label="모바일 메뉴" hidden>
    {NAV_LINKS.map((link) => <a href={link.href}>{link.label}</a>)}
    <a href="/contact">프로젝트 상담하기</a>
  </nav>
</header>

<script>
  const button = document.querySelector<HTMLButtonElement>('.menu-button');
  const menu = document.querySelector<HTMLElement>('#mobile-menu');
  button?.addEventListener('click', () => {
    const open = button.getAttribute('aria-expanded') === 'true';
    button.setAttribute('aria-expanded', String(!open));
    if (menu) menu.hidden = open;
  });
  menu?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
    if (menu && button) { menu.hidden = true; button.setAttribute('aria-expanded', 'false'); }
  }));
</script>
